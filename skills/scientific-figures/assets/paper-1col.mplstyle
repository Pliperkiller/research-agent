# paper-1col.mplstyle - generated by the scientific-figures skill
# Sizes chosen for the medium; do not override them panel by panel.

figure.figsize      : 3.5, 2.16
figure.dpi          : 110
savefig.dpi         : 600
savefig.format      : pdf
savefig.bbox        : tight
savefig.pad_inches  : 0.02
savefig.transparent : False
figure.constrained_layout.use : True

font.size           : 8
axes.titlesize      : 8
axes.labelsize      : 8
xtick.labelsize     : 7
ytick.labelsize     : 7
legend.fontsize     : 7
figure.titlesize    : 8

font.family         : sans-serif
mathtext.fontset    : dejavusans

# no chartjunk: only the two spines that hold the data
axes.spines.top     : False
axes.spines.right   : False
axes.linewidth      : 0.8
axes.edgecolor      : 333333
axes.facecolor      : white
figure.facecolor    : white
axes.grid           : False
grid.color          : cccccc
grid.linewidth      : 0.5
grid.alpha          : 0.5

axes.axisbelow      : True
axes.titlelocation  : left
axes.titlepad       : 6.0
axes.labelpad       : 4.0

lines.linewidth     : 1.0
lines.markersize    : 3.0
lines.solid_capstyle: round

xtick.direction     : out
ytick.direction     : out
xtick.major.size    : 3.0
ytick.major.size    : 3.0
xtick.major.width   : 0.8
ytick.major.width   : 0.8
xtick.minor.visible : True
ytick.minor.visible : True
xtick.minor.size    : 1.5
ytick.minor.size    : 1.5

legend.frameon      : False
legend.handlelength : 1.6
legend.borderaxespad: 0.4

image.cmap          : viridis
image.origin        : lower
image.interpolation : nearest

errorbar.capsize    : 2.0
scatter.edgecolors  : none

# colorblind-safe qualitative palette (Okabe-Ito)
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])
